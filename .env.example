# Cover photos for automated posts. Also enables the Pexels picker in the admin
# post form (searched server-side, the key is never exposed to the browser).
PEXELS_API_KEY=

# Set to true to upload the daily Pexels cover to ImageKit instead of using the
# Pexels URL directly (default: use the Pexels URL, no ImageKit storage).
# AUTO_BLOG_UPLOAD_COVER=true

# Set true to publish generated posts automatically. Default is draft-first.
AUTO_PUBLISH=false
